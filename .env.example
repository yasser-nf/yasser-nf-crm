# Yasser NF CRM — Environment Configuration
#
# ADR-001: only .env.local is used. Secrets never enter Git.
# Copy this file to .env.local and replace the placeholder values.
#
#   cp .env.example .env.local
#
# The placeholders below are shape-valid so the project builds before a Supabase
# project exists. They point at nothing — authentication will fail honestly
# until real values are supplied. Nothing is mocked.

# ---------------------------------------------------------------------------
# SUPABASE — public
# Safe to expose. These reach the browser.
# Supabase Dashboard > Project Settings > Data API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key

# ---------------------------------------------------------------------------
# DATABASE — server only
# NEVER expose. Used by Drizzle and drizzle-kit.
# Supabase Dashboard > Project Settings > Database > Connection string
#
# Use the pooled connection string (port 6543) for the application.
# Use the direct connection string (port 5432) for migrations.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:placeholder@placeholder.supabase.co:5432/postgres
