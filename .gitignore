# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
# ADR-001: secrets never enter Git. .env.example is the only committed env file.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# testing artifacts
/test-results
/playwright-report
/blob-report
/coverage

.vercel
.env*

# agent skills
# Installed per-project by `npx skills add`, not authored here. They are
# tooling for whoever is working on the repo, they carry no application code,
# and at 4MB they would otherwise be committed by `git add -A` and uploaded
# into the production bundle by `vercel deploy`, which reads this file.
.agents/
.claude/skills/
skills-lock.json
